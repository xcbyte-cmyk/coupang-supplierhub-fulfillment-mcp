# Copy to a local .env file. Never commit real passwords or secret keys.
LOGEN_WEB_ID=
LOGEN_WEB_PASSWORD=
LOGEN_INTEGRATION_METHOD=website_mcp
LOGEN_API_ENVIRONMENT=test
# Optional. When omitted, LOGEN_CUSTOMER_CODE is used as the official userId fallback.
LOGEN_API_USER_ID=
LOGEN_API_SECRET_KEY=
# Compatibility alias for the same Logen secretKey value.
LOGEN_REST_API=
LOGEN_CUSTOMER_CODE=

# Required before a live Logen order can be registered.
FULFILLMENT_SENDER_NAME=
FULFILLMENT_SENDER_ADDRESS=
FULFILLMENT_SENDER_TELEPHONE=
FULFILLMENT_SENDER_MOBILE=
FULFILLMENT_SENDER_POSTAL_CODE=
LOGEN_FARE_TYPE=030
LOGEN_BOX_TYPE_CODE=
LOGEN_DELIVERY_FARE=0

# Optional master-data and shipment workbook imports.
FULFILLMENT_DB_PATH=data/fulfillment.db
FULFILLMENT_MASTER_DATA_FILE=
FULFILLMENT_SHIPMENT_WORKBOOK=

# Stage 10 workbook source/output. The source is copied and expanded; it is never overwritten.
FULFILLMENT_SHIPMENT_UPLOAD_TEMPLATE=
FULFILLMENT_SHIPMENT_UPLOAD_OUTPUT_DIR=data/shipment-upload-workbooks
FULFILLMENT_PYTHON_EXECUTABLE=python
FULFILLMENT_SHIP_TIME=16:00
FULFILLMENT_SHIPMENT_DOCUMENTS_DIR=data/shipment-documents

# Live browser calibration. JSON values contain Playwright selectors.
SUPPLIERHUB_SHIPMENT_URL=
SUPPLIERHUB_FULFILLMENT_SELECTORS_JSON={}
SUPPLIERHUB_SHIPMENT_UPLOAD_URL=https://supplier.coupang.com/ibs/shipment/parcel/bulk-creation/upload
SUPPLIERHUB_SHIPMENT_JOBS_URL=https://supplier.coupang.com/ibs/shipment/parcel/bulk-creation/jobs
SUPPLIERHUB_SHIPMENT_LIST_URL=https://supplier.coupang.com/ibs/asn/active?type=parcel
# JSON must include shipDateInput and shipTimeInput for the stage-15 dispatch schedule.
# It must also include shipmentOrderNo so same-FC/same-EDD POs remain separate.
SUPPLIERHUB_SHIPMENT_SELECTORS_JSON='{"uploadReadyMarker":"#shipDate","shipDateInput":"#shipDate","shipTimeInput":"#shipTime","carrierVisibleInput":"#deliveryCompany_chosen .chosen-single","carrierVisibleOption":"#deliveryCompany_chosen .chosen-results li.active-result:has-text(\"로젠택배\")","carrierHiddenInput":"#deliveryCompany","workbookInput":"#uploadFile","uploadSubmitButton":"#upload-btn:not([disabled])","jobsReadyMarker":"#search-btn","jobsRows":"table.scmTable tbody tr.center","jobsFileName":"td:nth-child(3)","jobsStatus":"td:nth-child(2)","jobsId":"td:nth-child(1)","jobsCreatedAt":"td:nth-child(6)","shipmentReadyMarker":"#shipment-search-btn","inboundDateInput":"#edd","shipmentSearchButton":"#shipment-search-btn","shipmentRows":"#parcel-tab tbody tr.heading","shipmentId":"td:nth-child(1)","shipmentOrderNo":"td:nth-child(3)","shipmentCenter":"td:nth-child(7)","shipmentExpectedInboundDate":"td:nth-child(6)"}'
SUPPLIERHUB_SHIPMENT_PDF_REQUESTS_JSON=[]
SUPPLIERHUB_DATE_INPUT_FORMAT=yyyy-MM-dd
LOGEN_REGISTRATION_URL=https://logis.ilogen.com/
LOGEN_WAYBILL_URL=https://logis.ilogen.com/common/html/main.html
LOGEN_TRACKING_URL=
LOGEN_SELECTORS_JSON={}

# Per-user values: replace these examples with the exact names displayed on this Windows PC.
# Do not copy another user's local/shared printer names. If the waybill printer is omitted,
# the current Logen adapter attempts to discover its calibrated AllLive suffix.
FULFILLMENT_ORDER_PRINTER=SINDOH N600 Series PCL-8
FULFILLMENT_SHIPMENT_PRINTER=SINDOH N600 Series PCL-8
FULFILLMENT_WAYBILL_PRINTER=

# Keep disabled until all sixteen live stages have been calibrated once.
FULFILLMENT_OPERATION_MODE=calibration
FULFILLMENT_SCHEDULE_ENABLED=false
FULFILLMENT_DATA_SOURCE=auto
